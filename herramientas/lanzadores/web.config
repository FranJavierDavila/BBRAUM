<?xml version="1.0" encoding="utf-8"?>
<!--
  B. BRAUN - Evaluacion de Inspeccion Visual (botellas de suero)
  Configuracion de IIS con HttpPlatformHandler 1.2

  INSTALACION:
  1. Instale "HttpPlatformHandler v1.2" (descarga oficial de Microsoft iis.net).
  2. Instale Node.js LTS en C:\Program Files\nodejs\ (ajuste processPath si cambia).
  3. Copie esta carpeta (aplicacion) al servidor, p. ej. C:\inetpub\bbraun-evaluacion\aplicacion
  4. Edite el valor de DATABASE_URL con la ruta ABSOLUTA real de datos\bbraun.db
     (use barras normales "/" y prefijo "file:").
  5. CAMBIE el valor de AUTH_SECRET por un secreto unico de instalacion.
  6. En IIS cree un sitio (o aplicacion) cuya raiz fisica sea ESTA carpeta.
     - Application Pool: "Sin codigo administrado" (No Managed Code).
     - El sitio debe permitir ejecucion de scripts y executables (handler).
  7. HttpPlatformHandler asigna un puerto dinamico automaticamente (%HTTP_PLATFORM_PORT%).

  NOTAS:
  - Los logs de salida de Node se escriben en la subcarpeta .\logs
  - La carpeta .\datos y .\public\uploads deben tener permiso de ESCRITURA
    para la identidad del Application Pool (ApplicationPoolIdentity).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="HttpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments="server.js"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\node"
                  startupTimeLimit="60"
                  requestTimeout="00:10:00">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="0.0.0.0" />
        <environmentVariable name="DATABASE_URL" value="file:C:/inetpub/bbraun-evaluacion/aplicacion/datos/bbraun.db" />
        <environmentVariable name="AUTH_SECRET" value="CAMBIAR-este-secreto-unico-de-instalacion" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
