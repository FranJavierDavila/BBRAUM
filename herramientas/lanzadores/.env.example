# Ejemplo de variables de entorno para la aplicación standalone.
# El lanzador (iniciar-servidor.sh / .bat) define todas automáticamente;
# este fichero solo documenta qué existe.

# Ruta absoluta de la base de datos SQLite (Prisma la requiere absoluta)
DATABASE_URL="file:/ruta/completa/a/datos-ficheros/bbraun.db"

# Carpeta de datos donde se guarda el material subido (fuera del directorio
# de la aplicación: sobrevive a actualizaciones y reconstrucciones)
UPLOADS_DIR="/ruta/completa/a/datos-ficheros/uploads"

# Secreto de firma de las cookies de sesión (CAMBIAR en producción)
AUTH_SECRET="cambiar-este-secreto-en-produccion"

# Puerto de escucha (por defecto 3000)
PORT=3000

# IP de escucha (por defecto 0.0.0.0 = todas las interfaces; BB_BIND la limita)
# BB_BIND=127.0.0.1
