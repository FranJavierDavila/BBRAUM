# Ruta absoluta de la base de datos SQLite (Prisma la requiere absoluta)
# Ajusta <ruta-del-proyecto> a la ruta real donde clones el proyecto.
DATABASE_URL="file:<ruta-del-proyecto>/db/custom.db"

# Secreto de firma de las cookies de sesión (cambia en producción)
AUTH_SECRET="cambiar-este-secreto-en-produccion"
